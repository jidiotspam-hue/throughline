# Copy to config.env and fill in your own values, then: chmod 600 config.env
# config.env is gitignored and must never be committed.

# The deployed throughline Worker.
THROUGHLINE_URL=https://throughline.example.workers.dev

# The browser passphrase (Worker secret PROXY_KEY).
PASSPHRASE=your-passphrase-here

# Shared token the backend uses for PUT /yt/backend (Worker secret UPDATE_KEY).
UPDATE_KEY=your-update-key-here
